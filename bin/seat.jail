#!/usr/bin/env bash
# Jailed launcher Band runs for each seat (symlinked as seat-<name>; bin/stand-up does this).
#  - The seat gets its own git identity, so every commit traces to the seat that made it.
#  - The seat sees the system read-only, and only these writable places: the work area
#    (result repositories and check output), its runtime's own state, and Band's local
#    socket and config. The specification package is visible read-only.
#  - Everything else under $HOME is hidden: other projects, cloud and ssh credentials,
#    API keys, browser profiles, the ssh/gpg agent sockets.
# Docker stays reachable (the checks build containers), so this guards against accidents,
# not against a hostile model. Paths come from seat.conf beside this file.
set -euo pipefail
SELF=$(readlink -f "$0"); BIN=$(dirname "$SELF")
NAME=${0##*/seat-}
TITLE="$(tr '[:lower:]' '[:upper:]' <<< "${NAME:0:1}")${NAME:1}"
H=$HOME
# The checks build containers. A login that joined the docker group but has not logged in
# again lacks it, and so does every process it starts; re-enter through `sg` (group membership,
# no password) so the seat can reach Docker however its daemon was started.
if [[ -z ${SEAT_SG:-} ]] && ! id -nG | grep -qw docker && id -nG "$(id -un)" | grep -qw docker; then
  export SEAT_SG=1; exec sg docker -c "$(printf '%q ' "$0" "$@")"
fi
# seat.conf sets WORK (absolute work area), KICKOFF (specification package), OC_BIN (dir holding the native opencode binary)
# shellcheck source=/dev/null
source "$BIN/seat.conf"
mkdir -p "$BIN/../logs"
{ echo "== $(date -Is) pid=$$ cwd=$PWD jailed"; printf 'arg: %q\n' "$@"; } >> "$BIN/../logs/launch-$NAME.log"
if [[ -n "${SEAT_JAIL_TEST:-}" ]]; then CMD=(bash -c "$SEAT_JAIL_TEST")
# On the agent protocol, a turn that closes with only SILENT reaches Band as a silent completion.
elif [[ ${1:-} == acp ]]; then CMD=(python3 "$H/.seat-bin/acp-quiet" "$H/.oc-bin/opencode" "$@")
else CMD=("$H/.oc-bin/opencode" "$@"); fi
case "$PWD" in "$WORK"*|"$KICKOFF"*) CD=$PWD ;; *) CD=$H ;; esac
# Each seat keeps its own runtime database and state, so every session and every token is attributable to one seat.
SEATDATA="$H/.local/share/opencode-seats/$NAME"
mkdir -p "$SEATDATA/share" "$SEATDATA/state" "$H/.cache/opencode" "$H/.config/opencode" "$WORK"
# The specification package's tools run from its virtualenv, whose interpreter may live under
# the hidden $HOME (a user-installed Python). Recreate each symlink hop there and expose the
# interpreter's install read-only, so the seat can run the supplied checks.
hidden() { [[ $1 == "$H"/* && $1 != "$KICKOFF"/* && $1 != "$WORK"/* ]]; }
PY=(); p="$KICKOFF/.venv/bin/python"
while [[ -L $p ]]; do
  t=$(readlink "$p"); hidden "$p" && PY+=(--symlink "$t" "$p")
  [[ $t == /* ]] || t="$(dirname "$p")/$t"; p=$t
done
[[ -e $p ]] && hidden "$p" && PY+=(--ro-bind "$(dirname "$(dirname "$p")")" "$(dirname "$(dirname "$p")")")
# Runtime rules for every seat, enforced by the runtime rather than asked of the model:
#  - no subagents: work done in a seat is that seat's, under its name, reported in the room;
#  - the supplied check files cannot be opened: a seat runs the checks and reads their results;
#  - the seats that plan and judge cannot edit the product;
#  - a message with newlines, backticks or $( on the command line is refused (use --body-file);
#  - a seat speaks only as itself: its Band session is set for it (JAM_SESSION), and acting as
#    another seat (--as, or another seat's --session) is refused;
#  - no bulk staging and no skipping hooks: each seat commits only its own paths (seat-hooks/pre-commit).
#  - no killing by command-line pattern (pkill -f): the pattern also matches the seat's own command;
#  - only the Builder moves the shared repository's checkout; another seat's checkout there is undone
#    (seat-hooks/post-checkout) — seats look at other commits in their own clone under /tmp.
# Generated at launch from the specification package's layout (every <track>/test folder).
CFG="$BIN/../run/opencode-$NAME.json"; mkdir -p "$(dirname "$CFG")"
{ printf '{"$schema":"https://opencode.ai/config.json","permission":{"task":"deny",'
  for tool in read list glob grep bash; do
    printf '"%s":{"*":"allow"' "$tool"
    for t in "$KICKOFF"/*/test; do
      [[ -d $t ]] || continue
      printf ',"*%s*":"deny"' "${t#"$KICKOFF"/}"   # matches absolute and relative paths and commands
    done
    # A message typed on the command line is mangled by the shell (backticks and $( run as
    # commands, so the handoff arrives gutted); multi-line messages must go through --body-file.
    # Staging everything sweeps other seats' unfinished files into this seat's commit; skipping
    # hooks or repointing them would skip the ownership check (seat-hooks/pre-commit).
    [[ $tool == bash ]] && for p in 'git add -A*' 'git add --all*' 'git add -u*' 'git add .' 'git add . *' 'git add ./' 'git commit -a*' 'git commit --all*' '*--no-verify*' '*core.hooksPath*' '*git commit -n*'; do
      printf ',"*%s":"deny"' "${p#\*}"
    done
    # `pkill -f <pattern>` also matches the shell running the seat's own command, which names the same
    # pattern: the Builder killed its own shell that way and its turn waited on the dead command until
    # the runtime's timeout, while four messages queued for it. Stop a process by the id saved when it started.
    [[ $tool == bash ]] && printf ',"*pkill *-f*":"deny","*pkill *--full*":"deny"'
    [[ $tool == bash ]] && for cli in jam band; do
      # "$(cat /tmp/file)" in double quotes is safe (the file's text is not re-run); later rules win.
      printf ',"*%s*send*$(*":"deny","*%s*send*\\"*$(cat /tmp/*)\\"*":"allow","*%s*send*\\n*":"deny","*%s*send*`*":"deny"' $cli $cli $cli $cli
      # After a summarised conversation one seat forgot its --session, found a bare send refused
      # ("peer not found") and posted its verdict --as the Foreman and the Builder.
      printf ',"*%s* --as *":"deny","*%s* --as=*":"deny","*%s* --session *":"deny","*%s* --session=*":"deny","*%s* --session df-%s *":"allow","*%s* --session=df-%s *":"allow"' $cli $cli $cli $cli $cli "$NAME" $cli "$NAME"
    done
    [[ $tool == bash ]] && printf '}' || printf '},'
  done
  # Seats that plan or judge never change the product: no edits inside a stage folder.
  # Only paths inside a stage folder (…/stage-N/…) match; a file named after a stage elsewhere does not.
  case $NAME in foreman|adversary)
    printf ',"edit":{"*":"allow"'
    for n in 1 2 3 4 5 6 7 8 9; do printf ',"*/stage-%s/*":"deny","stage-%s/*":"deny"' $n $n; done
    printf '}' ;; esac
  printf '}'
  # Keyed providers are reached through bin/key-proxy, outside the jail: the seat names the model,
  # the proxy adds the key. No key is ever in a seat's environment, files or runtime config.
  printf ',"provider":{"nvidia":{"npm":"@ai-sdk/openai-compatible","name":"NVIDIA Build (through bin/key-proxy)",'
  printf '"options":{"baseURL":"http://127.0.0.1:%s/v1","apiKey":"held-by-key-proxy"},' "${KEY_PROXY_PORT:-18911}"
  printf '"models":{"nemotron-3-ultra":{"id":"nvidia/nemotron-3-ultra-550b-a55b","name":"Nemotron 3 Ultra 550B","tool_call":true,"limit":{"context":262144,"output":32768}}}}}'
  printf '}\n'; } > "$CFG.$$"
# A malformed rule file would start the seat with no rules at all: refuse to start instead.
python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$CFG.$$" 2>>"$BIN/../logs/launch-$NAME.log" \
  || { echo "seat.jail: generated runtime rules are not valid JSON ($CFG.$$); not starting" >&2; exit 1; }
mv "$CFG.$$" "$CFG"
# The work area's root is read-only: seats write only inside the folders that exist when they
# start (the run's repository and checks/), so nothing a seat writes lands where the next run
# would find it. Create the run's repository before the seats start.
QLOG="$BIN/../logs/acp-quiet-$NAME.log"; touch "$QLOG"   # silent settlements and withheld text, per seat
# The seat's model and its second model, from its mandate's `Model:` and `Fallback model:` lines:
# while the first is capped, the filter carries the seat on with the second (see acp-quiet).
MANDATE="$BIN/../mandates/$NAME.md"; MODEL=; FALLBACK=
if [[ -f $MANDATE ]]; then
  MODEL=$(sed -n 's/^Model:[[:space:]]*//p' "$MANDATE" | head -1 | awk '{print $1}')
  FALLBACK=$(sed -n 's/^Fallback model:[[:space:]]*//p' "$MANDATE" | head -1 | awk '{print $1}')
fi
WB=(); for d in "$WORK"/*/ "$WORK"/.[!.]*/; do [[ -d $d ]] && WB+=(--bind "${d%/}" "${d%/}"); done
# Its own process space: a seat that restarts a server with `pkill python3` or `fuser -k <port>`
# can only reach its own processes, never another seat's runtime, the key proxy or Band.
exec bwrap --unshare-pid --ro-bind / / --dev /dev --proc /proc --tmpfs /tmp \
  --tmpfs "$H" --tmpfs "/run/user/$(id -u)" \
  --ro-bind "$OC_BIN" "$H/.oc-bin" \
  --ro-bind "$BIN/acp-quiet" "$H/.seat-bin/acp-quiet" \
  --ro-bind "$BIN/seat-hooks" "$H/.seat-hooks" \
  --bind "$QLOG" "$H/.seat-log" --setenv ACP_QUIET_LOG "$H/.seat-log" \
  --setenv ACP_QUIET_MODEL "$MODEL" --setenv ACP_QUIET_FALLBACK "$FALLBACK" \
  --setenv ACP_QUIET_RUNTIME_LOG "$H/.local/share/opencode/log/opencode.log" \
  --bind "$SEATDATA/share" "$H/.local/share/opencode" \
  --bind "$H/.cache/opencode" "$H/.cache/opencode" \
  --bind "$H/.config/opencode" "$H/.config/opencode" \
  --bind "$SEATDATA/state" "$H/.local/state/opencode" \
  --ro-bind-try "$H/.cache/ms-playwright" "$H/.cache/ms-playwright" \
  --bind "$H/.jam" "$H/.jam" \
  --ro-bind "$WORK" "$WORK" "${WB[@]}" \
  --ro-bind "$KICKOFF" "$KICKOFF" "${PY[@]}" \
  --ro-bind "$CFG" "$H/.config/opencode-seat.json" --setenv OPENCODE_CONFIG "$H/.config/opencode-seat.json" \
  --die-with-parent --chdir "$CD" \
  --setenv HOME "$H" --setenv PATH "$H/.oc-bin:/usr/local/bin:/usr/bin:/bin" \
  --setenv GIT_AUTHOR_NAME "$TITLE" --setenv GIT_COMMITTER_NAME "$TITLE" \
  --setenv GIT_AUTHOR_EMAIL "$NAME@factory.invalid" --setenv GIT_COMMITTER_EMAIL "$NAME@factory.invalid" \
  --setenv SEAT_NAME "$NAME" --setenv JAM_SESSION "df-$NAME" --setenv SEAT_WORK "$WORK" --setenv GIT_CONFIG_COUNT 1 --setenv GIT_CONFIG_KEY_0 core.hooksPath --setenv GIT_CONFIG_VALUE_0 "$H/.seat-hooks" \
  --unsetenv SSH_AUTH_SOCK --unsetenv GPG_AGENT_INFO \
  "${CMD[@]}"
