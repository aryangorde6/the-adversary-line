#!/usr/bin/env python3
"""Lets seats use a keyed model provider without ever holding the key.

A seat's runtime can run shell commands, and whatever a seat prints can reach the room, and the
room's log is published with the result. So no key is put in a seat's environment or jail.
Instead this proxy runs outside every jail, reads the key once from the key file, and forwards
two endpoints — list models, chat completions — to the provider with the key added. Seats point
their runtime at http://127.0.0.1:<port>/v1 with no key. Responses (including streamed ones) pass
through unchanged. Only request counts and status codes are logged, never bodies or keys.

usage: key-proxy [--port 18911] [--keys ~/.config/band-hack/keys.env] [--log PATH]
       (provider: NVIDIA Build, https://integrate.api.nvidia.com/v1, key NVIDIA_API_KEY)
"""
import argparse, http.client, http.server, pathlib, re, socketserver, ssl, sys, threading, time

UPSTREAM_HOST, UPSTREAM_BASE, KEY_NAME = "integrate.api.nvidia.com", "/v1", "NVIDIA_API_KEY"
ALLOWED = {("GET", "/v1/models"), ("POST", "/v1/chat/completions")}
HOP = {"connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te", "trailers",
       "transfer-encoding", "upgrade", "host", "authorization", "content-length"}


def load_key(path: pathlib.Path) -> str:
    for line in path.read_text().splitlines():
        m = re.match(rf"\s*(?:export\s+)?{KEY_NAME}\s*=\s*['\"]?([^'\"\s]+)", line)
        if m:
            return m.group(1)
    sys.exit(f"key-proxy: no {KEY_NAME} in {path}")


class Handler(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    key, log_path, lock = "", None, threading.Lock()

    def log_message(self, fmt, *args):  # quiet: we log our own one-line records
        pass

    def record(self, status, started, sent):
        line = (f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime())} {self.command} {self.path} "
                f"-> {status} {time.time() - started:.1f}s {sent}B")
        if self.log_path:
            with self.lock, open(self.log_path, "a") as f:
                f.write(line + "\n")

    def refuse(self, code, msg):
        body = f'{{"error":{{"message":"{msg}"}}}}'.encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def forward(self):
        started = time.time()
        path = self.path.split("?", 1)[0]
        if (self.command, path) not in ALLOWED:
            self.refuse(404, "not forwarded by key-proxy"); self.record(404, started, 0); return
        body = self.rfile.read(int(self.headers.get("Content-Length") or 0)) if self.command == "POST" else None
        headers = {k: v for k, v in self.headers.items() if k.lower() not in HOP}
        headers["Authorization"] = f"Bearer {self.key}"
        conn = http.client.HTTPSConnection(UPSTREAM_HOST, timeout=600, context=ssl.create_default_context())
        try:
            conn.request(self.command, UPSTREAM_BASE + self.path[len("/v1"):], body=body, headers=headers)
            up = conn.getresponse()
        except OSError as e:
            self.refuse(502, f"upstream unreachable: {type(e).__name__}"); self.record(502, started, 0); return
        self.send_response(up.status)
        for k, v in up.getheaders():
            if k.lower() not in HOP:
                self.send_header(k, v)
        self.send_header("Transfer-Encoding", "chunked")
        self.end_headers()
        sent = 0
        try:  # relay as it arrives, so streamed completions stay streamed
            while chunk := up.read1(65536):
                self.wfile.write(b"%x\r\n%s\r\n" % (len(chunk), chunk)); self.wfile.flush(); sent += len(chunk)
            self.wfile.write(b"0\r\n\r\n"); self.wfile.flush()
        except (BrokenPipeError, ConnectionResetError):
            pass
        finally:
            conn.close()
            self.record(up.status, started, sent)

    do_GET = do_POST = forward


class Server(socketserver.ThreadingMixIn, http.server.HTTPServer):
    daemon_threads, allow_reuse_address = True, True


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--port", type=int, default=18911)
    ap.add_argument("--keys", default=str(pathlib.Path.home() / ".config/band-hack/keys.env"))
    ap.add_argument("--log")
    a = ap.parse_args()
    Handler.key = load_key(pathlib.Path(a.keys).expanduser())
    Handler.log_path = a.log
    srv = Server(("127.0.0.1", a.port), Handler)
    print(f"key-proxy: http://127.0.0.1:{a.port}/v1 -> https://{UPSTREAM_HOST}{UPSTREAM_BASE} (key held here only)", flush=True)
    srv.serve_forever()


if __name__ == "__main__":
    main()
