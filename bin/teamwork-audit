#!/usr/bin/env python3
"""Read a run the way a judge reads it: the room log against the git history.

usage: teamwork-audit <room.json> <result-repo>

Reports, from evidence only:
  - work distribution: commits and changed lines per seat identity (a seat commits as
    <seat>@factory.invalid); commits by anyone else, such as the human's packaging commit that
    adds the factory's files and room.json, are listed apart and not counted as work
  - traceability: which seat commits are named (by hash prefix) in a seat's room message
  - review: the checker's verdicts (a line stating PASS or BLOCKED, on a commit it names; or "no row … fails at
    <commit>", reported apart as NO-FAIL and never counted as a PASS), each commit's verdict once, whether the
    shipped checks were passing at it, and for each BLOCKED the fix and the next PASS (or the next NO-FAIL on a
    commit the checker did not block later). The fix is the first builder or finisher commit on the way to the
    passing commit whose message names a row or finding the BLOCKED cited; if none names one, the passing commit itself
  - autonomy: every human message in the room, with its time
"""
import collections, datetime as dt, json, re, subprocess, sys

HASH = re.compile(r"\b[0-9a-f]{7,40}\b")
# A verdict is a line that starts with it ("VERDICT: PASS — applies to commit …", "**BLOCKED on `579bcfb`**",
# "**Stage 1: PASS.**", "`93b62d8…` — **BLOCKED**.") or says "Verdict: BLOCKED" or "the verdict is still BLOCKED"
# anywhere in it; "No new BLOCKED" or "this is not a BLOCKED" in prose is not one.
VERDICT = re.compile(r"^(?:(?i:verdict)\b.*?\b(BLOCKED|PASS)\b|(?:(?i:stage)\s+\d+\W+)?(BLOCKED|PASS)\b|[0-9a-f]{7,40}\W+(BLOCKED|PASS)\b)"
                     r"|\b(?i:verdict)\W{1,6}(BLOCKED|PASS)\b"
                     r"|\b(?i:verdict)\b[^.\n]{0,40}?\b(?i:is|stays|remains)\s+(?i:still\s+)?\**(BLOCKED|PASS)\b")
# A checker that will not write PASS while rows are undecided reports "No row in the stage-2 ledger fails at `41fc347`
# — 130 of 132 decided". That is its own kind, NO-FAIL, never counted as a PASS.
NOFAIL = re.compile(r"(?i)\bno (?:ledger )?row\b[^.\n]{0,40}?\bfails? at\W{0,3}[0-9a-f]{7,40}\b")
DECIDED = re.compile(r"\b(\d+) of (\d+)(?: rows)? decided\b")
SHIPPED = re.compile(r"(?i)\b(?:supplied|shipped) (?:checks|suite|tests)\b")
FAILED = re.compile(r"(?i)\b(\d+)\s+failed\b")
RATIO = re.compile(r"\b(\d+)\s*(?:/|of)\s*(\d+)\b")
STAGE_SAID = re.compile(r"(?i)\bstage\s+(\d+)\W{0,3}(pass|fail)")  # the harness's own words: "stage 1 **pass**, stage 2 fail"
EXPECTED = re.compile(r"(?i)\bstage\s+(\d+)\W{0,3}fail\w*\W*[^.\n]{0,40}?\b(?:expected|out of scope)")
SAYS_PASS = re.compile(r"(?i)\b(?:checks|suite|tests)\s+(?:all\s+)?pass(?:es|ed)?\b")  # "the supplied checks pass"
ROW = re.compile(r"\b(?:[A-Z][A-Z0-9]{0,3}-\d{1,3}|F-?\d{1,2}|[A-Z]{1,2}\d{1,3})\b")  # a ledger row or finding id: MV-04, S1-021, F4, F-06, E14, R3


def git(repo, *args):
    return subprocess.run(["git", "-C", repo, *args], capture_output=True, text=True, check=True).stdout


def verdict(content):
    """(BLOCKED, PASS or NO-FAIL, the line) for the message's first verdict line, else (None, None).
    Lines inside a fenced code block are quoted output ("PASS E16b … on the mutant"), never a verdict."""
    fenced = False
    for line in str(content).splitlines():
        if line.lstrip().startswith("```"):
            fenced = not fenced
            continue
        if fenced:
            continue
        line = re.sub(r"^(?:\s*@\[\[[^\]]*\]\]|[\s*_#>`\u2013\u2014-])+", "", line)  # "@seat — PASS for `…`"
        # A verdict in quotation marks is someone else's words being quoted, not one given: the checker's
        # 'What I am objecting to is the attribution: "Adversary verdict: PASS" is a sentence I did not write'.
        line = re.sub(r"\"[^\"\n]{0,120}\"|\u201c[^\u201d\n]{0,120}\u201d", '""', line)
        m = VERDICT.search(line)
        if m:
            return next(g for g in m.groups() if g), line
        if NOFAIL.search(line):
            return "NO-FAIL", line
    return None, None


def commit_in(repo, *texts):
    """The first hash in the texts that names a commit in the repository (7 characters)."""
    for t in texts:
        for h in HASH.findall(t or ""):
            if subprocess.run(["git", "-C", repo, "cat-file", "-e", f"{h}^{{commit}}"], capture_output=True).returncode == 0:
                return h[:7]
    return None


def shipped_clean(content):
    """True when the message reports the shipped checks all passing, False when some failed, None when it does not say.
    Read from the table right under the line naming them, else the sentence naming them ("120 collected, 114 passed,
    6 failed", "120/120"; the whole line when that sentence gives nothing), else from the harness's verdict in words ("stage 1 pass, stage 2 fail"; a later stage the message
    calls expected or out of scope to fail does not count) or "the supplied checks pass"."""
    lines = str(content).splitlines()
    expected = {n for n in EXPECTED.findall(str(content))}
    for i, line in enumerate(lines):
        named = SHIPPED.search(line)
        if not named:
            continue
        j = i + 1 + (i + 2 < len(lines) and not lines[i + 1].strip() and lines[i + 2].lstrip().startswith("|"))
        table = []
        while j < len(lines) and lines[j].lstrip().startswith("|"):
            table.append([c.strip(" *`").lower() for c in lines[j].strip().strip("|").split("|")]); j += 1
        if table and "failed" in table[0]:
            k = table[0].index("failed")
            fails = [int(r[k]) for r in table[1:] if k < len(r) and r[k].isdigit()]
            if fails:
                return not any(fails)
        # the sentence that names them first: a long line also carries other counts ("0 of 572 entries");
        # the whole line only when that sentence says nothing ("120/120 in both modes; … the shipped suite misses …")
        for part in (re.split(r"(?<=\D)\.\s", line[named.start():], maxsplit=1)[0], line):
            fails = [int(n) for n in FAILED.findall(part)]
            if fails:
                return not any(fails)
            if RATIO.search(part):
                return all(a == b for a, b in RATIO.findall(part))
            said = STAGE_SAID.findall(part)
            if said:
                return any(v.lower() == "pass" for _, v in said) and not any(
                    v.lower() == "fail" and n not in expected for n, v in said)
            if SAYS_PASS.search(part):
                return True
    return None


def shipped_words(content):
    """The harness's verdict in words on the first sentence naming the shipped checks ("stage 1 pass, stage 2 pass,
    stage 3 fail"), else None. Printed instead of "failing" when only a later, not yet built stage fails."""
    for line in str(content).splitlines():
        named = SHIPPED.search(line)
        if named:
            said = STAGE_SAID.findall(re.split(r"(?<=\D)\.\s", line[named.start():], maxsplit=1)[0])
            if said:
                return ", ".join(f"stage {n} {v.lower()}" for n, v in said)
    return None


def epoch(t):
    return dt.datetime.fromisoformat(str(t).replace("Z", "+00:00")).timestamp()


def fix_for(repo, blocked, after, good, rows, said=()):
    """(hash, author email, commit time, subject, note) of the fix for a BLOCKED on `blocked` posted at `after`
    (epoch seconds) that `good` later passed. The fix is the first builder or finisher commit on the way to `good`,
    made after the BLOCKED, that names one of the cited `rows` in its own message or on the line of a builder's or
    finisher's room message that gives its hash ("15e8c55 … (F2)"); else the first one such a room message, posted
    after the BLOCKED, names together with a cited row or the blocked commit anywhere in it. A verdict on a commit
    that was already superseded can have its fix made before it: a commit on the way to `good` that a room line
    names with a cited row ("(made before the verdict)"). If none is found, `good` itself ("(the passing commit)")."""
    log = [c.split("\x1f") for c in git(repo, "log", "--reverse", "--format=%H%x1f%ae%x1f%at%x1f%B%x1e",
                                        f"{blocked}..{good}", "--", "stage-*").split("\x1e") if c.strip()]
    log = [(h.strip(), who, int(at), msg) for h, who, at, msg in log if re.match(r"(builder|finisher)@", who)]
    mine = [m for m in said if re.match(r"(Builder|Finisher)", str(m.get("senderName", "")))]
    def posted(m):
        return epoch(m.get("insertedAt") or "1970-01-01T00:00:00Z")
    def on_a_line(h, msgs):
        return any(h[:7] in line and rows & set(ROW.findall(line)) for m in msgs for line in str(m.get("content", "")).splitlines())
    later = [m for m in mine if posted(m) > after]
    for h, who, at, msg in log:
        if at > after and (rows & set(ROW.findall(msg)) or on_a_line(h, later)):
            return h, who, at, msg.strip().splitlines()[0], ""
    for h, who, at, msg in log:
        if at > after and any(h[:7] in str(m.get("content", "")) and (rows & set(ROW.findall(str(m.get("content", ""))))
                                                                      or blocked[:7] in str(m.get("content", ""))) for m in later):
            return h, who, at, msg.strip().splitlines()[0], ""
    for h, who, at, msg in log:
        if at <= after and (rows & set(ROW.findall(msg)) or on_a_line(h, mine)):
            return h, who, at, msg.strip().splitlines()[0], " (made before the verdict)"
    h, who, at, subject = git(repo, "log", "-1", "--format=%H%x1f%ae%x1f%at%x1f%s", good).strip().split("\x1f")
    return h, who, int(at), subject, " (the passing commit)"


def main():
    room_path, repo = sys.argv[1], sys.argv[2]
    msgs = json.load(open(room_path))["messages"]
    said = [m for m in msgs if str(m.get("senderType", "")).lower() == "agent" and m.get("messageType") == "text"]
    human = [m for m in msgs if str(m.get("senderType", "")).lower() == "user" and m.get("messageType") == "text"]
    text = "\n".join(str(m.get("content", "")) for m in said)

    log = git(repo, "log", "--all", "--numstat", "--format=@@%H|%an|%ae|%cI|%s")
    commits, cur = [], None
    for line in log.splitlines():
        if line.startswith("@@"):
            h, an, ae, when, s = line[2:].split("|", 4)
            cur = {"hash": h, "author": an, "seat": ae.endswith("@factory.invalid"), "when": when, "subject": s, "lines": 0}
            commits.append(cur)
        elif line.strip() and cur:
            a, d, *_ = line.split("\t")
            cur["lines"] += (int(a) if a.isdigit() else 0) + (int(d) if d.isdigit() else 0)

    others = [c for c in commits if not c["seat"]]
    commits = [c for c in commits if c["seat"]]
    print("== Work distribution (seat commits, changed lines)")
    by = collections.defaultdict(lambda: [0, 0])
    for c in commits:
        by[c["author"]][0] += 1; by[c["author"]][1] += c["lines"]
    total = sum(v[1] for v in by.values()) or 1
    for a, (n, l) in sorted(by.items(), key=lambda kv: -kv[1][1]):
        print(f"  {a:12} {n:4} commits {l:7} lines  {100 * l / total:5.1f}%")
    for c in others:
        print(f"  not a seat:  {c['hash'][:7]} {c['author']}: {c['subject'][:50]} ({c['lines']} lines, not counted)")

    print("== Traceability (commit hash named in a seat's room message)")
    traced = [c for c in commits if re.search(re.escape(c["hash"][:7]), text)]
    print(f"  {len(traced)} of {len(commits)} commits are named in the room")
    for c in commits:
        if c not in traced:
            print(f"  not named: {c['hash'][:7]} {c['author']}: {c['subject'][:60]}")

    print("== Review (the checker's verdicts: a line stating PASS or BLOCKED on a commit, each commit's verdict once)")
    verdicts, seen = [], set()
    for m in sorted((m for m in said if str(m.get("senderName", "")).startswith("Adversary")), key=lambda m: m.get("insertedAt", "")):
        v, line = verdict(m.get("content"))
        c = v and commit_in(repo, line, str(m.get("content")))
        if c and (v, c) not in seen:  # a restated verdict on the same commit is not a new one
            seen.add((v, c)); verdicts.append((m, v, c))
    nofail = sum(v == "NO-FAIL" for _, v, _ in verdicts)
    print(f"  {len(verdicts)} verdicts: {sum(v == 'PASS' for _, v, _ in verdicts)} PASS, "
          f"{sum(v == 'BLOCKED' for _, v, _ in verdicts)} BLOCKED"
          + (f", {nofail} no failing row (the checker did not write PASS)" if nofail else ""))
    def decided(m):
        d = DECIDED.search(verdict(m.get("content"))[1] or "") or DECIDED.search(str(m.get("content")))
        return f" ({d[1]} of {d[2]} decided)" if d else ""
    def settled(i):  # a PASS, or a NO-FAIL on a commit the checker did not block afterwards
        pm, pv, pc = verdicts[i]
        return pv == "PASS" or (pv == "NO-FAIL" and not any(v == "BLOCKED" and c == pc for _, v, c in verdicts[i + 1:]))
    for i, (m, v, c) in enumerate(verdicts):
        shipped = {True: ", shipped checks all passing", False: ", shipped checks failing", None: ""}[shipped_clean(m.get("content"))]
        said_words = shipped_words(m.get("content"))
        if said_words and shipped.endswith("failing"):  # the harness's own words, not a reading of them
            shipped = f", shipped checks: {said_words}"
        print(f"  {v:7} {m['insertedAt'][:19]}Z on {c}{shipped}{decided(m) if v == 'NO-FAIL' else ''}", end="")
        if v == "BLOCKED":
            nxt = next((verdicts[j] for j in range(i + 1, len(verdicts)) if settled(j)), None)
            if nxt:
                h, _, at, subject, note = fix_for(repo, c, epoch(m["insertedAt"]), nxt[2], set(ROW.findall(str(m.get("content")))), said)
                when = dt.datetime.fromtimestamp(at, dt.timezone.utc).strftime("%H:%M")
                print(f" -> fix {h[:7]} {when}Z {subject[:50]!r}{note}"
                      f" -> {'PASS' if nxt[1] == 'PASS' else 'no failing row'} at {nxt[0]['insertedAt'][:19]}Z on {nxt[2]}"
                      f"{decided(nxt[0]) if nxt[1] == 'NO-FAIL' else ''}", end="")
            else:
                print(" -> no PASS yet", end="")
        print()

    print("== Autonomy (human text messages in the room)")
    print(f"  {len(human)} human message(s)")
    for m in human:
        print(f"  {m.get('insertedAt')}: {str(m.get('content', ''))[:90]!r}")


if __name__ == "__main__":
    main()
